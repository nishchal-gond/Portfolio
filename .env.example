# Environment Variables Template
# Copy this file to .env.local and fill in your actual values.
# NEVER commit real secrets. Set production values in Vercel → Settings → Environment Variables.

# Resend API key for the contact form (https://resend.com/api-keys)
RESEND_API_KEY=re_xxxxxxxxxxxx

# Inbox that receives contact-form messages
EMAIL=you@example.com

# Optional: Socket.IO server for live cursors/chat. Leave empty to disable the feature.
NEXT_PUBLIC_WS_URL=

# Optional: Umami analytics. The script is only injected when both are set.
UMAMI_DOMAIN=
UMAMI_SITE_ID=

# Optional: "Ask AI" assistant (https://console.anthropic.com). The widget only appears when this is set.
ANTHROPIC_API_KEY=
# Optional overrides for the assistant (defaults: claude-opus-5, low effort)
ANTHROPIC_MODEL=
ANTHROPIC_EFFORT=
